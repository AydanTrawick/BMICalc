# Merge these top-level settings into your existing secrets, before section headers.
USDA_API_KEY = ""
OPENAI_API_KEY = "your-openai-api-key"
ANTHROPIC_API_KEY = "your-anthropic-api-key"
ELEVENLABS_API_KEY = "your-elevenlabs-api-key"
ELEVENLABS_VOICE_ID = "your-elevenlabs-voice-id"
NEON_DATABASE_URL = "postgresql://user:password@host/database?sslmode=require"
ASSISTANT_TIMEZONE = "America/New_York"

# Equipment Classifier feedback (pages/EquipmentClassifier.py, pages/Feedback_Review.py)
ADMIN_PASSWORD = "choose-a-strong-password"
# "r2" or "local"; if omitted, falls back to "local" unless all R2_* keys below are set.
STORAGE_BACKEND = "r2"
R2_ACCOUNT_ID = "your-cloudflare-account-id"
R2_ACCESS_KEY_ID = "your-r2-access-key-id"
R2_SECRET_ACCESS_KEY = "your-r2-secret-access-key"
R2_BUCKET_NAME = "your-r2-bucket-name"
